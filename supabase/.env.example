# Contoh env Supabase (JANGAN isi secret asli di sini).
# Salin ke .env lokal / secrets dashboard bila perlu. File .env tidak di-commit.

# URL project, cth: https://abcdefghijklm.supabase.co
SUPABASE_URL=https://<ref>.supabase.co
# Publishable key (proyek baru) atau anon key (proyek lama).
# Boleh di app (via --dart-define) / firmware (secrets.h); RLS read-only.
SUPABASE_PUBLISHABLE_KEY=change-me-publishable-key

# ── Hanya di Dashboard → Edge Functions → Secrets (JANGAN ke repo/app) ──
# SUPABASE_SERVICE_ROLE_KEY=...
# DEVICE_KEY_HASH=...  # sha256 hex dari device_key firmware
