# ── Server ────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ── Database ──────────────────────────────────────────────
# Untuk `bun run dev` di host (MySQL docker di port 3307).
# Di dalam Docker, DATABASE_URL di-override docker-compose ke host `mysql:3306`.
DATABASE_URL=mysql://simohe:simohe@127.0.0.1:3307/simohe
MYSQL_ROOT_PASSWORD=simohe_root
MYSQL_DATABASE=simohe
MYSQL_USER=simohe
MYSQL_PASSWORD=simohe

# ── Auth ──────────────────────────────────────────────────
# Token aplikasi (single user). WAJIB diganti di produksi.
APP_TOKEN=change-me-app-token
# Origin aplikasi web yang diizinkan (CORS). Pisahkan dengan koma.
APP_CORS_ORIGIN=http://localhost:8080

# ── Seed device ───────────────────────────────────────────
# 32 karakter hex. Kosongkan untuk generate otomatis (dicetak saat seed).
DEVICE_KEY=
DEVICE_NAME=Reaktor Pupuk 1
DEVICE_LOCATION=

# ── Rate limit (per key, request per detik) ───────────────
RATE_LIMIT_INGEST_PER_SEC=1
RATE_LIMIT_APP_PER_SEC=10

# ── Job background (sampling, offline, expiry, retention) ─
JOBS_ENABLED=true

# ── Docker (opsional, untuk deployment) ───────────────────
# Port host container server. Dibuat beda dari PORT dev (3000) agar tidak
# bentrok; sesuaikan saat deploy.
DOCKER_SERVER_HOST_PORT=3001
# Port host container MySQL (dev lokal memakai 3307).
DOCKER_MYSQL_HOST_PORT=3307
# DATABASE_URL dari dalam jaringan Docker (host = nama service `mysql`).
# Samakan kredensial dengan MYSQL_* di atas.
DOCKER_DATABASE_URL=mysql://simohe:simohe@mysql:3306/simohe
# Seed otomatis saat container server start (hanya bila DEVICE_KEY diisi).
RUN_SEED=true

# ── Database terpusat (opsional) ──────────────────────────
# MySQL di komputer server (bersama aplikasi lain), bukan container bawaan.
# Setup awal: jalankan tools/db/central-setup.sql sebagai root di server MySQL.
# Jalankan server saja:
#   docker compose -f docker-compose.yml -f docker-compose.central-db.yml up -d server
# Jika MySQL ada di komputer yang SAMA dengan container, pakai host.docker.internal;
# jika beda komputer, pakai IP/DNS server MySQL.
CENTRAL_DATABASE_URL=mysql://simohe_app:GANTI-PASSWORD-KUAT@192.168.1.10:3306/simohe
