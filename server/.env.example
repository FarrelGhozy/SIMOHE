# ── Server ────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ── Database (MySQL lokal, tanpa container) ───────────────
# MySQL dijalankan langsung di host. Setup awal (sekali):
#   sudo mysql < tools/db/setup.sql
# Kredensial harus sama dengan yang dipakai di setup.sql.
DATABASE_URL=mysql://simohe_app:S1mohe!Local@127.0.0.1:3306/simohe

# ── Auth ──────────────────────────────────────────────────
# Token aplikasi (single user). WAJIB diganti di produksi.
APP_TOKEN=change-me-app-token
# Origin aplikasi web yang diizinkan (CORS). Pisahkan dengan koma.
APP_CORS_ORIGIN=http://localhost:8080

# ── Seed device ───────────────────────────────────────────
# 32 karakter hex. Kosongkan untuk generate otomatis (dicetak saat seed).
DEVICE_KEY=
DEVICE_NAME=Reaktor Pupuk 1
DEVICE_LOCATION=

# ── Rate limit (per key, request per detik) ───────────────
RATE_LIMIT_INGEST_PER_SEC=1
RATE_LIMIT_APP_PER_SEC=10

# ── Job background (sampling, offline, expiry, retention) ─
JOBS_ENABLED=true

# ── Docker (container server) ─────────────────────────────
# Container server memakai jaringan host, jadi DATABASE_URL di atas dipakai apa adanya.
RUN_SEED=true

# ── Test (dibuat otomatis oleh tests/preload.ts) ──────────
# Kredensial root MySQL lokal untuk membuat database `simohe_test`.
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=3306
TEST_DB_ROOT_USER=root
TEST_DB_ROOT_PASSWORD=
